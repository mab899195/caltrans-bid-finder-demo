<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Daily scrape at 9:30 a.m. (the Mac's local time; set the Mac to Pacific time).
     If the Mac is asleep at 9:30, launchd runs the job when it wakes.
     Install: see README.md -->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.caltransbidfinder.scrape</string>
  <key>WorkingDirectory</key>
  <string>/path/to/caltrans-bid-finder</string>
  <key>ProgramArguments</key>
  <array>
    <string>/path/to/caltrans-bid-finder/.venv/bin/python</string>
    <string>-m</string>
    <string>scraper.run</string>
    <string>scheduled</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>BID_FINDER_COMPANY</key>
    <string></string>
    <key>BID_FINDER_CONTACT</key>
    <string></string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>9</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/path/to/caltrans-bid-finder/data/scrape.log</string>
  <key>StandardErrorPath</key>
  <string>/path/to/caltrans-bid-finder/data/scrape.log</string>
</dict>
</plist>

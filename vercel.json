{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "flask",
  "functions": {
    "app.py": {
      "maxDuration": 300,
      "excludeFiles": "{tests/**,data/**,deploy/**,.venv/**}"
    }
  },
  "crons": [
    {
      "path": "/api/cron/scrape",
      "schedule": "30 16 * * *"
    }
  ]
}
